<mxfile host="app.diagrams.net">
  <diagram id="politique-securite" name="Politique de sécurité">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#F6F7F9" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Politique de sécurité&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontColor=#1B1B1F;fontSize=36;" vertex="1" parent="1"><mxGeometry x="64" y="48" width="1100" height="52" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Quatre axes pilotés en amélioration continue (PDCA), pour la nouvelle plateforme et tout le SI" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontColor=#1B1B1F;fontSize=18;fontColor=#4A5160;" vertex="1" parent="1"><mxGeometry x="64" y="104" width="1100" height="30" as="geometry"/></mxCell>
        <mxCell id="legend" value='&lt;font color="#1F5FBF"&gt;&lt;b&gt;■ Prévenir&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color="#A84B07"&gt;&lt;b&gt;■ Détecter et réagir&lt;/b&gt;&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontColor=#1B1B1F;fontSize=14;align=right;" vertex="1" parent="1"><mxGeometry x="1176" y="64" width="360" height="28" as="geometry"/></mxCell>
        <mxCell id="plan" value='&lt;font style="font-size:12px" color="#1F5FBF"&gt;&lt;b&gt;1 · PLAN&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font style="font-size:22px"&gt;Inventaire et analyse des risques&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Registre de toutes les applications et de leurs données&lt;br&gt;• Analyse des risques (EBIOS RM) : vraisemblance × impact&lt;br&gt;• Objectifs : 0 CRITICAL en production, MFA pour tous' style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F5FBF;strokeWidth=2;align=left;verticalAlign=top;spacing=20;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=15;fontColor=#1B1B1F;" vertex="1" parent="1"><mxGeometry x="64" y="200" width="560" height="230" as="geometry"/></mxCell>
        <mxCell id="do" value='&lt;font style="font-size:12px" color="#1F5FBF"&gt;&lt;b&gt;2 · DO&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font style="font-size:22px"&gt;Scans de sécurité et protection&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Pipeline : secrets, SAST, dépendances, image, DAST&lt;br&gt;• SI existant : scans mensuels des serveurs et du CMS&lt;br&gt;• MFA, moindre privilège, sauvegardes 3-2-1' style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F5FBF;strokeWidth=2;align=left;verticalAlign=top;spacing=20;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=15;fontColor=#1B1B1F;" vertex="1" parent="1"><mxGeometry x="976" y="200" width="560" height="230" as="geometry"/></mxCell>
        <mxCell id="check" value='&lt;font style="font-size:12px" color="#A84B07"&gt;&lt;b&gt;3 · CHECK&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font style="font-size:22px"&gt;Supervision et indicateurs&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Prometheus + Grafana : disponibilité, erreurs, alertes&lt;br&gt;• Journaux centralisés, tests de restauration Veeam&lt;br&gt;• Indicateurs : failles ouvertes, délai de correction' style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A84B07;strokeWidth=2;align=left;verticalAlign=top;spacing=20;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=15;fontColor=#1B1B1F;" vertex="1" parent="1"><mxGeometry x="976" y="560" width="560" height="230" as="geometry"/></mxCell>
        <mxCell id="act" value="&lt;font style=&quot;font-size:12px&quot; color=&quot;#A84B07&quot;&gt;&lt;b&gt;4 · ACT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:22px&quot;&gt;Incidents et retours d'expérience&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Détecter → contenir → corriger → restaurer → analyser&lt;br&gt;• Violation de données : CNIL (et ICO) sous 72 h&lt;br&gt;• Chaque incident devient une nouvelle règle ou alerte" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A84B07;strokeWidth=2;align=left;verticalAlign=top;spacing=20;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=15;fontColor=#1B1B1F;" vertex="1" parent="1"><mxGeometry x="64" y="560" width="560" height="230" as="geometry"/></mxCell>
        <mxCell id="pdca" value="&lt;b&gt;Amélioration continue&lt;/b&gt;&lt;br&gt;Plan → Do → Check → Act&lt;br&gt;revue complète chaque année" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1B1B1F;strokeColor=none;fontColor=#FFFFFF;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=14;" vertex="1" parent="1"><mxGeometry x="672" y="410" width="256" height="170" as="geometry"/></mxCell>
        <mxCell id="scope" value="&lt;b&gt;Périmètre&lt;/b&gt; : nouvelle plateforme · SI existant (CMS, stock, CRM, caisses, Gmail, serveur de fichiers, infra média Evil Ed) · évolutions v2 et v3" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontColor=#1B1B1F;fontSize=15;fontColor=#4A5160;" vertex="1" parent="1"><mxGeometry x="64" y="816" width="1472" height="28" as="geometry"/></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B6170;strokeWidth=2;" edge="1" parent="1" source="plan" target="do"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B6170;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="do" target="check"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B6170;strokeWidth=2;" edge="1" parent="1" source="check" target="act"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B6170;strokeWidth=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="act" target="plan"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
