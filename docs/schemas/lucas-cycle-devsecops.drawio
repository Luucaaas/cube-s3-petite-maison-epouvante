<mxfile host="app.diagrams.net">
  <diagram id="cycle-devsecops" name="Cycle DevSecOps">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#F6F7F9" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Cycle de vie DevSecOps&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Inter;fontColor=#1B1B1F;fontSize=36;" vertex="1" parent="1"><mxGeometry x="64" y="48" width="1100" height="52" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="La sécurité intégrée à chaque phase — appliquée à la démo CI/CD de La Petite Maison de l'Épouvante" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Inter;fontColor=#1B1B1F;fontSize=18;fontColor=#4A5160;" vertex="1" parent="1"><mxGeometry x="64" y="104" width="1100" height="30" as="geometry"/></mxCell>
        <mxCell id="legend" value='&lt;font color="#1F5FBF"&gt;&lt;b&gt;■ DEV&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color="#A84B07"&gt;&lt;b&gt;■ OPS&lt;/b&gt;&lt;/font&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Inter;fontColor=#1B1B1F;fontSize=14;align=right;" vertex="1" parent="1"><mxGeometry x="1336" y="64" width="200" height="28" as="geometry"/></mxCell>
        <mxCell id="p1" value='&lt;font style="font-size:12px" color="#1F5FBF"&gt;&lt;b&gt;01 · DEV&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font style="font-size:22px"&gt;Planifier&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Exigences de sécurité, analyse de risques, RGPD ; paiement délégué (PCI-DSS)&lt;br&gt;&lt;br&gt;&lt;font color="#4A5160"&gt;→ Issues + GitHub Projects&lt;/font&gt;' style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F5FBF;strokeWidth=2;align=left;verticalAlign=top;spacing=18;fontFamily=Inter;fontSize=15;fontColor=#1B1B1F;" vertex="1" parent="1"><mxGeometry x="64" y="200" width="320" height="216" as="geometry"/></mxCell>
        <mxCell id="p2" value='&lt;font style="font-size:12px" color="#1F5FBF"&gt;&lt;b&gt;02 · DEV&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font style="font-size:22px"&gt;Coder&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Revue de code par pull request, style vérifié, aucun secret dans le dépôt&lt;br&gt;&lt;br&gt;&lt;font color="#4A5160"&gt;→ ruff · Gitleaks — jobs lint, secrets&lt;/font&gt;' style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F5FBF;strokeWidth=2;align=left;verticalAlign=top;spacing=18;fontFamily=Inter;fontSize=15;fontColor=#1B1B1F;" vertex="1" parent="1"><mxGeometry x="448" y="200" width="320" height="216" as="geometry"/></mxCell>
        <mxCell id="p3" value='&lt;font style="font-size:12px" color="#1F5FBF"&gt;&lt;b&gt;03 · DEV&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font style="font-size:22px"&gt;Construire&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Dépendances épinglées et scannées, image minimale exécutée sans root&lt;br&gt;&lt;br&gt;&lt;font color="#4A5160"&gt;→ Trivy · Docker — jobs deps, build&lt;/font&gt;' style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F5FBF;strokeWidth=2;align=left;verticalAlign=top;spacing=18;fontFamily=Inter;fontSize=15;fontColor=#1B1B1F;" vertex="1" parent="1"><mxGeometry x="832" y="200" width="320" height="216" as="geometry"/></mxCell>
        <mxCell id="p4" value='&lt;font style="font-size:12px" color="#1F5FBF"&gt;&lt;b&gt;04 · DEV&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font style="font-size:22px"&gt;Tester&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tests automatisés et analyse statique du code à chaque push (SAST)&lt;br&gt;&lt;br&gt;&lt;font color="#4A5160"&gt;→ pytest · Semgrep — jobs test, sast&lt;/font&gt;' style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F5FBF;strokeWidth=2;align=left;verticalAlign=top;spacing=18;fontFamily=Inter;fontSize=15;fontColor=#1B1B1F;" vertex="1" parent="1"><mxGeometry x="1216" y="200" width="320" height="216" as="geometry"/></mxCell>
        <mxCell id="p5" value='&lt;font style="font-size:12px" color="#A84B07"&gt;&lt;b&gt;05 · OPS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font style="font-size:22px"&gt;Publier&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Image scannée avant usage : une faille CRITICAL bloque la livraison&lt;br&gt;&lt;br&gt;&lt;font color="#4A5160"&gt;→ Trivy · registre — job scan-image&lt;/font&gt;' style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A84B07;strokeWidth=2;align=left;verticalAlign=top;spacing=18;fontFamily=Inter;fontSize=15;fontColor=#1B1B1F;" vertex="1" parent="1"><mxGeometry x="1216" y="560" width="320" height="216" as="geometry"/></mxCell>
        <mxCell id="p6" value='&lt;font style="font-size:12px" color="#A84B07"&gt;&lt;b&gt;06 · OPS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font style="font-size:22px"&gt;Déployer&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Déploiement reproductible, puis test du service en marche (DAST)&lt;br&gt;&lt;br&gt;&lt;font color="#4A5160"&gt;→ Helm · ZAP — deploy, smoke, dast&lt;/font&gt;' style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A84B07;strokeWidth=2;align=left;verticalAlign=top;spacing=18;fontFamily=Inter;fontSize=15;fontColor=#1B1B1F;" vertex="1" parent="1"><mxGeometry x="832" y="560" width="320" height="216" as="geometry"/></mxCell>
        <mxCell id="p7" value='&lt;font style="font-size:12px" color="#A84B07"&gt;&lt;b&gt;07 · OPS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font style="font-size:22px"&gt;Exploiter&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Authentification centralisée, hébergement en France, secrets hors du code&lt;br&gt;&lt;br&gt;&lt;font color="#4A5160"&gt;→ Keycloak · OVHcloud (cible)&lt;/font&gt;' style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A84B07;strokeWidth=2;align=left;verticalAlign=top;spacing=18;fontFamily=Inter;fontSize=15;fontColor=#1B1B1F;" vertex="1" parent="1"><mxGeometry x="448" y="560" width="320" height="216" as="geometry"/></mxCell>
        <mxCell id="p8" value='&lt;font style="font-size:12px" color="#A84B07"&gt;&lt;b&gt;08 · OPS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;font style="font-size:22px"&gt;Superviser&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Métriques et alertes, gestion des incidents, retour vers la planification&lt;br&gt;&lt;br&gt;&lt;font color="#4A5160"&gt;→ Prometheus · Grafana (bonus)&lt;/font&gt;' style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A84B07;strokeWidth=2;align=left;verticalAlign=top;spacing=18;fontFamily=Inter;fontSize=15;fontColor=#1B1B1F;" vertex="1" parent="1"><mxGeometry x="64" y="560" width="320" height="216" as="geometry"/></mxCell>
        <mxCell id="sec" value="&lt;b&gt;Sécurité continue (shift left)&lt;/b&gt;&lt;br&gt;Chaque contrôle est un job du pipeline : s'il échoue, la suite est bloquée." style="rounded=1;arcSize=12;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#1B1B1F;strokeColor=none;fontColor=#FFFFFF;fontFamily=Inter;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="448" y="448" width="704" height="80" as="geometry"/></mxCell>
        <mxCell id="jobs" value="Ordre des jobs, identique sur GitLab CI et GitHub Actions : lint → test → secrets → sast → deps → build → scan-image → deploy → smoke → dast" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Inter;fontColor=#1B1B1F;fontSize=15;fontColor=#4A5160;" vertex="1" parent="1"><mxGeometry x="64" y="816" width="1472" height="28" as="geometry"/></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B6170;strokeWidth=2;fontSize=13;fontColor=#4A5160;labelBackgroundColor=#F6F7F9;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B6170;strokeWidth=2;fontSize=13;fontColor=#4A5160;labelBackgroundColor=#F6F7F9;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B6170;strokeWidth=2;fontSize=13;fontColor=#4A5160;labelBackgroundColor=#F6F7F9;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="livraison" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B6170;strokeWidth=2;fontSize=13;fontColor=#4A5160;labelBackgroundColor=#F6F7F9;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B6170;strokeWidth=2;fontSize=13;fontColor=#4A5160;labelBackgroundColor=#F6F7F9;" edge="1" parent="1" source="p5" target="p6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B6170;strokeWidth=2;fontSize=13;fontColor=#4A5160;labelBackgroundColor=#F6F7F9;" edge="1" parent="1" source="p6" target="p7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B6170;strokeWidth=2;fontSize=13;fontColor=#4A5160;labelBackgroundColor=#F6F7F9;" edge="1" parent="1" source="p7" target="p8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="retours" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5B6170;strokeWidth=2;fontSize=13;fontColor=#4A5160;labelBackgroundColor=#F6F7F9;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p8" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
