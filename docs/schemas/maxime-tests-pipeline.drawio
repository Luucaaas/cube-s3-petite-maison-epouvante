        <mxCell id="c1" value="" style="rounded=0;fillColor=#F6F7F9;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="900" as="geometry"/></mxCell>
        <mxCell id="c2" value="&lt;b&gt;Les tests dans le pipeline : chaque test protège un attribut qualité&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=38;fontColor=#1B1B1F;" vertex="1" parent="1"><mxGeometry x="64" y="36" width="1480" height="52" as="geometry"/></mxCell>
        <mxCell id="c3" value="Du plus rapide (à chaque modification) au plus proche de la production — attributs ISO/IEC 25010 retenus pour la plateforme" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=18;fontColor=#4A4F5C;" vertex="1" parent="1"><mxGeometry x="64" y="92" width="1480" height="30" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;1 · Code&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#C9CDD6&quot;&gt;à chaque pull request&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#1B1B1F;strokeColor=none;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=19;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="64" y="146" width="350" height="58" as="geometry"/></mxCell>
        <mxCell id="c5" value="" style="rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#E3E6EB;" vertex="1" parent="1"><mxGeometry x="64" y="212" width="350" height="478" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b&gt;Analyse de style du code&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1F5FC7&quot;&gt;&lt;b&gt;Maintenabilité&lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#4A4F5C&quot;&gt; · bloquant&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#E8F0FC;strokeColor=#1F5FC7;strokeWidth=2.5;fontFamily=Helvetica;fontSize=16;fontColor=#1B1B1F;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="80" y="228" width="318" height="64" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b&gt;Tests unitaires&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1F5FC7&quot;&gt;&lt;b&gt;Maintenabilité&lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#4A4F5C&quot;&gt; · bloquant&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#E8F0FC;strokeColor=#1F5FC7;strokeWidth=2.5;fontFamily=Helvetica;fontSize=16;fontColor=#1B1B1F;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="80" y="304" width="318" height="64" as="geometry"/></mxCell>
        <mxCell id="c8" value="&lt;b&gt;Tests de contrat d&#x27;API&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6A3FB5&quot;&gt;&lt;b&gt;Compatibilité&lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#4A4F5C&quot;&gt; · bloquant&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#F1ECFA;strokeColor=#6A3FB5;strokeWidth=2.5;dashed=1;dashPattern=6 4;fontFamily=Helvetica;fontSize=16;fontColor=#1B1B1F;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="80" y="380" width="318" height="64" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;b&gt;Détection de secrets&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;Sécurité&lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#4A4F5C&quot;&gt; · bloquant&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FDECEC;strokeColor=#C62828;strokeWidth=2.5;fontFamily=Helvetica;fontSize=16;fontColor=#1B1B1F;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="80" y="456" width="318" height="64" as="geometry"/></mxCell>
        <mxCell id="c10" value="&lt;b&gt;Analyse statique du code (SAST)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;Sécurité&lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#4A4F5C&quot;&gt; · bloquant&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FDECEC;strokeColor=#C62828;strokeWidth=2.5;fontFamily=Helvetica;fontSize=16;fontColor=#1B1B1F;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="80" y="532" width="318" height="64" as="geometry"/></mxCell>
        <mxCell id="c11" value="&lt;b&gt;Analyse des dépendances&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;Sécurité&lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#4A4F5C&quot;&gt; · bloque si CRITICAL&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FDECEC;strokeColor=#C62828;strokeWidth=2.5;fontFamily=Helvetica;fontSize=16;fontColor=#1B1B1F;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="80" y="608" width="318" height="64" as="geometry"/></mxCell>
        <mxCell id="c12" value="&lt;b&gt;2 · Construction&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#C9CDD6&quot;&gt;image du service&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#1B1B1F;strokeColor=none;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=19;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="438" y="146" width="350" height="58" as="geometry"/></mxCell>
        <mxCell id="c13" value="" style="rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#E3E6EB;" vertex="1" parent="1"><mxGeometry x="438" y="212" width="350" height="478" as="geometry"/></mxCell>
        <mxCell id="c14" value="&lt;b&gt;Analyse de l&#x27;image&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;Sécurité&lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#4A4F5C&quot;&gt; · bloque si CRITICAL&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FDECEC;strokeColor=#C62828;strokeWidth=2.5;fontFamily=Helvetica;fontSize=16;fontColor=#1B1B1F;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="454" y="228" width="318" height="64" as="geometry"/></mxCell>
        <mxCell id="c15" value="L&#x27;image testée est exactement celle qui sera déployée : on ne reconstruit jamais entre le test et la production." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=15;fontColor=#4A4F5C;" vertex="1" parent="1"><mxGeometry x="454" y="310" width="318" height="120" as="geometry"/></mxCell>
        <mxCell id="c16" value="&lt;b&gt;3 · Déploiement&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#C9CDD6&quot;&gt;environnement de test&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#1B1B1F;strokeColor=none;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=19;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="812" y="146" width="350" height="58" as="geometry"/></mxCell>
        <mxCell id="c17" value="" style="rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#E3E6EB;" vertex="1" parent="1"><mxGeometry x="812" y="212" width="350" height="478" as="geometry"/></mxCell>
        <mxCell id="c18" value="&lt;b&gt;Test de fumée&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;Fiabilité&lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#4A4F5C&quot;&gt; · bloquant&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#EAF5EB;strokeColor=#2E7D32;strokeWidth=2.5;fontFamily=Helvetica;fontSize=16;fontColor=#1B1B1F;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="828" y="228" width="318" height="64" as="geometry"/></mxCell>
        <mxCell id="c19" value="&lt;b&gt;Test dynamique de sécurité (DAST)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;Sécurité&lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#4A4F5C&quot;&gt; · rapport&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FDECEC;strokeColor=#C62828;strokeWidth=2.5;fontFamily=Helvetica;fontSize=16;fontColor=#1B1B1F;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="828" y="304" width="318" height="64" as="geometry"/></mxCell>
        <mxCell id="c20" value="&lt;b&gt;Tests d&#x27;accessibilité&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#00838F&quot;&gt;&lt;b&gt;Capacité d&#x27;interaction&lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#4A4F5C&quot;&gt; · rapport&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#E5F5F6;strokeColor=#00838F;strokeWidth=2.5;dashed=1;dashPattern=6 4;fontFamily=Helvetica;fontSize=16;fontColor=#1B1B1F;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="828" y="380" width="318" height="64" as="geometry"/></mxCell>
        <mxCell id="c21" value="Le service tourne vraiment : on teste ce que verra l&#x27;utilisateur, pas seulement le code." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=15;fontColor=#4A4F5C;" vertex="1" parent="1"><mxGeometry x="828" y="462" width="318" height="120" as="geometry"/></mxCell>
        <mxCell id="c22" value="&lt;b&gt;4 · En continu&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#C9CDD6&quot;&gt;et avant les pics&lt;/font&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#1B1B1F;strokeColor=none;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=19;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="1186" y="146" width="350" height="58" as="geometry"/></mxCell>
