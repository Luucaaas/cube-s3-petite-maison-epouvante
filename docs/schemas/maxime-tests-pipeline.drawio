        <mxCell id="c24" value="&lt;b&gt;Test de charge&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B4530F&quot;&gt;&lt;b&gt;Performance&lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#4A4F5C&quot;&gt; · avant chaque festival&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FDF0E6;strokeColor=#B4530F;strokeWidth=2.5;dashed=1;dashPattern=6 4;fontFamily=Helvetica;fontSize=16;fontColor=#1B1B1F;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1202" y="228" width="318" height="64" as="geometry"/></mxCell>
        <mxCell id="c25" value="&lt;b&gt;Nouvelle analyse des images en production&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C62828&quot;&gt;&lt;b&gt;Sécurité&lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#4A4F5C&quot;&gt; · chaque semaine&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FDECEC;strokeColor=#C62828;strokeWidth=2.5;dashed=1;dashPattern=6 4;fontFamily=Helvetica;fontSize=16;fontColor=#1B1B1F;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1202" y="304" width="318" height="64" as="geometry"/></mxCell>
        <mxCell id="c26" value="&lt;b&gt;Test de restauration des sauvegardes&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b&gt;Fiabilité&lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#4A4F5C&quot;&gt; · chaque semestre&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#EAF5EB;strokeColor=#2E7D32;strokeWidth=2.5;dashed=1;dashPattern=6 4;fontFamily=Helvetica;fontSize=16;fontColor=#1B1B1F;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1202" y="380" width="318" height="64" as="geometry"/></mxCell>
        <mxCell id="c27" value="De nouvelles failles sont publiées chaque jour et la charge réelle varie : certains tests ne s&#x27;arrêtent pas à la livraison." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=15;fontColor=#4A4F5C;" vertex="1" parent="1"><mxGeometry x="1202" y="462" width="318" height="120" as="geometry"/></mxCell>
