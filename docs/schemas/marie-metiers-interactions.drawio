        <mxCell id="subtitle" value="Qui fait quoi pour construire la plateforme de La Petite Maison de l&#x27;Épouvante, et ce que chaque rôle transmet aux autres" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=17;fontColor=#4A5160;" vertex="1" parent="1"><mxGeometry x="64" y="92" width="1300" height="28" as="geometry"/></mxCell>
        <mxCell id="z_a" value="&lt;font color=&quot;#A84B07&quot;&gt;&lt;b&gt;CADRER LE BESOIN&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;fillColor=#A84B070D;strokeColor=#A84B07;dashed=1;dashPattern=6 4;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="64" y="168" width="336" height="584" as="geometry"/></mxCell>
        <mxCell id="z_b" value="&lt;font color=&quot;#1F5FBF&quot;&gt;&lt;b&gt;CONCEVOIR ET CONSTRUIRE&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;fillColor=#1F5FBF0D;strokeColor=#1F5FBF;dashed=1;dashPattern=6 4;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="528" y="168" width="336" height="584" as="geometry"/></mxCell>
        <mxCell id="z_c" value="&lt;font color=&quot;#1E7F4F&quot;&gt;&lt;b&gt;LIVRER, PROTÉGER, EXPLOITER&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=2;absoluteArcSize=1;html=1;fillColor=#1E7F4F0D;strokeColor=#1E7F4F;dashed=1;dashPattern=6 4;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=12;" vertex="1" parent="1"><mxGeometry x="992" y="168" width="336" height="584" as="geometry"/></mxCell>
        <mxCell id="moa" value="&lt;b&gt;&lt;font style=&quot;font-size:17px&quot;&gt;Maîtrise d&amp;#x27;ouvrage&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4A5160&quot;&gt;La direction : porte la vision, valide budget, priorités et recette finale&lt;/font&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A84B07;strokeWidth=2;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=13;fontColor=#1B1B1F;" vertex="1" parent="1"><mxGeometry x="96" y="216" width="272" height="96" as="geometry"/></mxCell>
        <mxCell id="po" value="&lt;b&gt;&lt;font style=&quot;font-size:17px&quot;&gt;Product owner&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4A5160&quot;&gt;Traduit le besoin en user stories, priorise, accepte chaque livraison&lt;/font&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A84B07;strokeWidth=2;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=13;fontColor=#1B1B1F;" vertex="1" parent="1"><mxGeometry x="96" y="352" width="272" height="96" as="geometry"/></mxCell>
        <mxCell id="ux" value="&lt;b&gt;&lt;font style=&quot;font-size:17px&quot;&gt;UX designer&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4A5160&quot;&gt;Parcours et maquettes testés avec les clients ; vérifie l&amp;#x27;accessibilité&lt;/font&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A84B07;strokeWidth=2;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=13;fontColor=#1B1B1F;" vertex="1" parent="1"><mxGeometry x="96" y="488" width="272" height="96" as="geometry"/></mxCell>
        <mxCell id="dpo" value="&lt;b&gt;&lt;font style=&quot;font-size:17px&quot;&gt;DPO&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4A5160&quot;&gt;Protection des données : conformité RGPD, registre des traitements&lt;/font&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A84B07;strokeWidth=2;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=13;fontColor=#1B1B1F;" vertex="1" parent="1"><mxGeometry x="96" y="624" width="272" height="96" as="geometry"/></mxCell>
        <mxCell id="archi" value="&lt;b&gt;&lt;font style=&quot;font-size:17px&quot;&gt;Architecte&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4A5160&quot;&gt;Choisit les technologies, découpe le système, garantit les attributs qualité&lt;/font&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F5FBF;strokeWidth=2;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=13;fontColor=#1B1B1F;" vertex="1" parent="1"><mxGeometry x="560" y="216" width="272" height="96" as="geometry"/></mxCell>
        <mxCell id="dev" value="&lt;b&gt;&lt;font style=&quot;font-size:17px&quot;&gt;Développeurs&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4A5160&quot;&gt;Codent front et back, écrivent les tests, se relisent par pull request&lt;/font&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F5FBF;strokeWidth=2;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=13;fontColor=#1B1B1F;" vertex="1" parent="1"><mxGeometry x="560" y="352" width="272" height="96" as="geometry"/></mxCell>
        <mxCell id="qa" value="&lt;b&gt;&lt;font style=&quot;font-size:17px&quot;&gt;QA (testeur)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4A5160&quot;&gt;Stratégie de test, tests automatisés et recette fonctionnelle&lt;/font&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F5FBF;strokeWidth=2;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=13;fontColor=#1B1B1F;" vertex="1" parent="1"><mxGeometry x="560" y="488" width="272" height="96" as="geometry"/></mxCell>
        <mxCell id="cdp" value="&lt;b&gt;&lt;font style=&quot;font-size:17px&quot;&gt;Chef de projet&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4A5160&quot;&gt;Scrum master : anime les rituels, suit le planning, lève les blocages&lt;/font&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F5FBF;strokeWidth=2;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=13;fontColor=#1B1B1F;" vertex="1" parent="1"><mxGeometry x="560" y="624" width="272" height="96" as="geometry"/></mxCell>
        <mxCell id="secu" value="&lt;b&gt;&lt;font style=&quot;font-size:17px&quot;&gt;Expert sécurité&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4A5160&quot;&gt;Analyse les risques, fixe les règles de sécurité, suit les failles&lt;/font&gt;" style="rounded=1;arcSize=6;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E7F4F;strokeWidth=2;align=left;verticalAlign=top;spacing=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;fontSize=13;fontColor=#1B1B1F;" vertex="1" parent="1"><mxGeometry x="1024" y="216" width="272" height="96" as="geometry"/></mxCell>
