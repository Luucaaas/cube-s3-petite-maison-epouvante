<mxfile host="app.diagrams.net">
  <diagram id="architecture-kubernetes" name="Architecture Kubernetes">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#F6F7F9" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="s1" value="" style="rounded=0;fillColor=#F6F7F9;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="900" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;Architecture Kubernetes : où tourne la démo&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=38;fontColor=#1B1B1F;" vertex="1" parent="1"><mxGeometry x="64" y="30" width="1480" height="50" as="geometry"/></mxCell>
        <mxCell id="s3" value="Plan de contrôle, nœuds de travail et entrée du trafic — avec le parcours de la release Helm &lt;b&gt;troc&lt;/b&gt; de ① à ⑦" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=18;fontColor=#4A4F5C;" vertex="1" parent="1"><mxGeometry x="64" y="84" width="1480" height="28" as="geometry"/></mxCell>
        <mxCell id="s4" value="&lt;b&gt;Pipeline CI/CD&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13.5px&quot; color=&quot;#4A4F5C&quot;&gt;job &lt;b&gt;deploy&lt;/b&gt; : helm upgrade --install troc --wait&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#4A4F5C;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#1B1B1F;align=left;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="64" y="170" width="250" height="96" as="geometry"/></mxCell>
        <mxCell id="s5" value="&lt;b&gt;Registre d&#x27;images&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13.5px&quot; color=&quot;#4A4F5C&quot;&gt;ghcr.io ou registre GitLab · image &lt;b&gt;troc:&amp;lt;sha&amp;gt;&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#4A4F5C;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#1B1B1F;align=left;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="64" y="395" width="250" height="96" as="geometry"/></mxCell>
        <mxCell id="s6" value="&lt;b&gt;Utilisateur&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13.5px&quot; color=&quot;#4A4F5C&quot;&gt;navigateur ; en démo : &lt;b&gt;test de fumée&lt;/b&gt; (appel de /health)&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#4A4F5C;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#1B1B1F;align=left;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="64" y="540" width="250" height="96" as="geometry"/></mxCell>
        <mxCell id="s7" value="" style="rounded=1;arcSize=2;fillColor=#FBFCFE;strokeColor=#1F5FC7;strokeWidth=1.5;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="350" y="140" width="1186" height="590" as="geometry"/></mxCell>
        <mxCell id="s8" value="&lt;b&gt;CLUSTER KUBERNETES&lt;/b&gt; · démo : kind, un seul nœud Docker qui joue tous les rôles · cible : Kubernetes managé OVHcloud (France)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=15;fontColor=#1F5FC7;" vertex="1" parent="1"><mxGeometry x="364" y="146" width="1158" height="24" as="geometry"/></mxCell>
        <mxCell id="s9" value="" style="rounded=1;arcSize=2;fillColor=#E8F0FC;strokeColor=#1F5FC7;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="374" y="196" width="1138" height="152" as="geometry"/></mxCell>
        <mxCell id="s10" value="&lt;b&gt;CONTROL PLANE&lt;/b&gt; · décide et mémorise · géré par l&#x27;hébergeur en cible" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=15;fontColor=#1F5FC7;" vertex="1" parent="1"><mxGeometry x="388" y="202" width="1110" height="24" as="geometry"/></mxCell>
        <mxCell id="s11" value="&lt;b&gt;Controller manager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13.5px&quot; color=&quot;#4A4F5C&quot;&gt;maintient le nombre voulu de pods (recrée un pod mort)&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F5FC7;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#1B1B1F;align=left;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="398" y="232" width="250" height="96" as="geometry"/></mxCell>
        <mxCell id="s12" value="&lt;b&gt;Scheduler&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13.5px&quot; color=&quot;#4A4F5C&quot;&gt;choisit le nœud de chaque nouveau pod&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F5FC7;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#1B1B1F;align=left;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="668" y="232" width="210" height="96" as="geometry"/></mxCell>
        <mxCell id="s13" value="&lt;b&gt;API server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13.5px&quot; color=&quot;#4A4F5C&quot;&gt;porte d&#x27;entrée unique du cluster : tout passe par lui&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F5FC7;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#1B1B1F;align=left;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="918" y="232" width="270" height="96" as="geometry"/></mxCell>
        <mxCell id="s14" value="&lt;b&gt;etcd&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13.5px&quot; color=&quot;#4A4F5C&quot;&gt;base clé-valeur : l&#x27;état voulu et l&#x27;état réel du cluster&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F5FC7;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#1B1B1F;align=left;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1228" y="232" width="260" height="96" as="geometry"/></mxCell>
        <mxCell id="s15" value="&lt;b&gt;Ingress&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13.5px&quot; color=&quot;#4A4F5C&quot;&gt;entrée HTTP(S), routage par URL&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#4A4F5C;strokeWidth=2;dashed=1;dashPattern=6 4;fontFamily=Helvetica;fontSize=16;fontColor=#1B1B1F;align=left;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="374" y="540" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="s16" value="&lt;b&gt;Service troc&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13.5px&quot; color=&quot;#4A4F5C&quot;&gt;port 8000, répartit vers les pods prêts&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FDF0E6;strokeColor=#B4530F;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#1B1B1F;align=left;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="374" y="632" width="190" height="86" as="geometry"/></mxCell>
        <mxCell id="s17" value="" style="rounded=1;arcSize=2;fillColor=#EAF5EB;strokeColor=#2E7D32;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="588" y="376" width="452" height="342" as="geometry"/></mxCell>
        <mxCell id="s18" value="&lt;b&gt;NŒUD WORKER 1&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=15;fontColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="602" y="382" width="424" height="24" as="geometry"/></mxCell>
        <mxCell id="s19" value="&lt;b&gt;Runtime&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13.5px&quot; color=&quot;#4A4F5C&quot;&gt;lance les conteneurs&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;fontFamily=Helvetica;fontSize=15;fontColor=#1B1B1F;align=left;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="604" y="412" width="136" height="62" as="geometry"/></mxCell>
        <mxCell id="s20" value="&lt;b&gt;kubelet&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13.5px&quot; color=&quot;#4A4F5C&quot;&gt;agent du nœud&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;fontFamily=Helvetica;fontSize=15;fontColor=#1B1B1F;align=left;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="748" y="412" width="136" height="62" as="geometry"/></mxCell>
        <mxCell id="s21" value="&lt;b&gt;kube-proxy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13.5px&quot; color=&quot;#4A4F5C&quot;&gt;règles réseau&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;fontFamily=Helvetica;fontSize=15;fontColor=#1B1B1F;align=left;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="892" y="412" width="132" height="62" as="geometry"/></mxCell>
        <mxCell id="s22" value="" style="rounded=1;arcSize=2;fillColor=#EAF5EB;strokeColor=#2E7D32;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1060" y="376" width="452" height="342" as="geometry"/></mxCell>
        <mxCell id="s23" value="&lt;b&gt;NŒUD WORKER 2&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=15;fontColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="1074" y="382" width="424" height="24" as="geometry"/></mxCell>
        <mxCell id="s24" value="&lt;b&gt;Runtime&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13.5px&quot; color=&quot;#4A4F5C&quot;&gt;lance les conteneurs&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;fontFamily=Helvetica;fontSize=15;fontColor=#1B1B1F;align=left;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1076" y="412" width="136" height="62" as="geometry"/></mxCell>
        <mxCell id="s25" value="&lt;b&gt;kubelet&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13.5px&quot; color=&quot;#4A4F5C&quot;&gt;agent du nœud&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;fontFamily=Helvetica;fontSize=15;fontColor=#1B1B1F;align=left;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1220" y="412" width="136" height="62" as="geometry"/></mxCell>
        <mxCell id="s26" value="&lt;b&gt;kube-proxy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13.5px&quot; color=&quot;#4A4F5C&quot;&gt;règles réseau&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;fontFamily=Helvetica;fontSize=15;fontColor=#1B1B1F;align=left;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1364" y="412" width="132" height="62" as="geometry"/></mxCell>
        <mxCell id="s27" value="&lt;b&gt;Pod troc · release Helm troc&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13.5px&quot; color=&quot;#4A4F5C&quot;&gt;Deployment (1 réplique) · conteneur non root · port 8000 · sondes de vie et de disponibilité sur /health&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FDF0E6;strokeColor=#B4530F;strokeWidth=2;fontFamily=Helvetica;fontSize=17;fontColor=#1B1B1F;align=left;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="604" y="490" width="420" height="100" as="geometry"/></mxCell>
        <mxCell id="s28" value="&lt;b&gt;Pod contrôleur d&#x27;ingress&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13.5px&quot; color=&quot;#4A4F5C&quot;&gt;reçoit le trafic externe et l&#x27;envoie aux Services&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#4A4F5C;strokeWidth=2;dashed=1;dashPattern=6 4;fontFamily=Helvetica;fontSize=17;fontColor=#1B1B1F;align=left;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="604" y="602" width="420" height="100" as="geometry"/></mxCell>
        <mxCell id="s29" value="&lt;b&gt;Pod troc · 2e réplique&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13.5px&quot; color=&quot;#4A4F5C&quot;&gt;montée en charge : même image, autre nœud (une panne de nœud n&#x27;arrête pas le service)&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FDF0E6;strokeColor=#B4530F;strokeWidth=2;dashed=1;dashPattern=6 4;fontFamily=Helvetica;fontSize=17;fontColor=#1B1B1F;align=left;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1076" y="490" width="420" height="100" as="geometry"/></mxCell>
        <mxCell id="s30" value="&lt;b&gt;Autres services de la plateforme&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13.5px&quot; color=&quot;#4A4F5C&quot;&gt;boutique, notifications, bus de messages… (un Deployment chacun)&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#4A4F5C;strokeWidth=2;dashed=1;dashPattern=6 4;fontFamily=Helvetica;fontSize=17;fontColor=#1B1B1F;align=left;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1076" y="602" width="420" height="100" as="geometry"/></mxCell>
