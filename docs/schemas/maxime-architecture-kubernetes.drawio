        <mxCell id="s31" value="①" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=21;fontColor=#B4530F;labelBackgroundColor=#F6F7F9;" vertex="1" parent="1"><mxGeometry x="687" y="173" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="s32" value="②" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=21;fontColor=#B4530F;labelBackgroundColor=#F6F7F9;" vertex="1" parent="1"><mxGeometry x="1195" y="267" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="s33" value="③" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=21;fontColor=#B4530F;labelBackgroundColor=#F6F7F9;" vertex="1" parent="1"><mxGeometry x="885" y="267" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="s34" value="④" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=21;fontColor=#B4530F;labelBackgroundColor=#F6F7F9;" vertex="1" parent="1"><mxGeometry x="885" y="349" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="s35" value="⑤" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=21;fontColor=#B4530F;labelBackgroundColor=#F6F7F9;" vertex="1" parent="1"><mxGeometry x="447" y="430" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="s36" value="⑥" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=21;fontColor=#B4530F;labelBackgroundColor=#F6F7F9;" vertex="1" parent="1"><mxGeometry x="827" y="469" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="s37" value="⑦" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=21;fontColor=#B4530F;labelBackgroundColor=#F6F7F9;" vertex="1" parent="1"><mxGeometry x="319" y="567" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="s38" value="&lt;b&gt;Déploiement de la démo&lt;/b&gt; · ① le job &lt;b&gt;deploy&lt;/b&gt; envoie la release Helm à l&#x27;API server · ② l&#x27;état voulu est enregistré dans etcd · ③ le scheduler choisit un nœud · ④ le kubelet de ce nœud démarre le pod · ⑤ le runtime dispose de l&#x27;image &lt;b&gt;troc:&amp;lt;sha&amp;gt;&lt;/b&gt; (en démo, le job la tire du registre et la charge dans kind) · ⑥ le kubelet sonde &lt;b&gt;/health&lt;/b&gt; : le pod n&#x27;est « prêt » qu&#x27;ensuite, et &lt;b&gt;helm --wait&lt;/b&gt; attend ce moment · ⑦ les requêtes entrent par l&#x27;ingress, le Service les envoie aux pods prêts — le test de fumée vérifie ce chemin." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=15.5;fontColor=#1B1B1F;" vertex="1" parent="1"><mxGeometry x="64" y="748" width="1472" height="80" as="geometry"/></mxCell>
        <mxCell id="s39" value="" style="rounded=1;fillColor=#FDF0E6;strokeColor=#B4530F;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="64" y="842" width="34" height="18" as="geometry"/></mxCell>
        <mxCell id="s40" value="démontré : release &lt;b&gt;troc&lt;/b&gt; déployée par nos deux pipelines" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=15;fontColor=#4A4F5C;" vertex="1" parent="1"><mxGeometry x="106" y="840" width="420" height="24" as="geometry"/></mxCell>
        <mxCell id="s41" value="" style="rounded=1;fillColor=#FFFFFF;strokeColor=#4A4F5C;strokeWidth=2;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="560" y="842" width="34" height="18" as="geometry"/></mxCell>
        <mxCell id="s42" value="cible pour la plateforme (en démo, le Service est exposé en NodePort)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=15;fontColor=#4A4F5C;" vertex="1" parent="1"><mxGeometry x="602" y="840" width="520" height="24" as="geometry"/></mxCell>
